# === Выберите одного провайдера, раскомментируйте нужные строки ===

# --- DeepSeek (рекомендую для теста, дешёвый) ---
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-ваш-ключ-deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# --- Mistral (альтернатива, хорош для кода) ---
# LLM_PROVIDER=mistral
# LLM_API_KEY=ваш-ключ-mistral
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=codestral-latest

# --- OpenAI (когда купите ключ) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-ваш-ключ-openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# --- Anthropic (через OpenAI-совместимый endpoint) ---
