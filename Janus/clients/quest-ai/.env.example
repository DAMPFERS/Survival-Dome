# Провайдер: deepseek или mistral
LLM_PROVIDER=mistral

DEEPSEEK_API_KEY=-
DEEPSEEK_MODEL=deepseek-chat

MISTRAL_API_KEY=-
MISTRAL_MODEL=mistral-large-latest

LLM_TEMPERATURE=0.35
# Лимит токенов на ответ. При LLM_THINKING=true в него входят и рассуждения — ставьте 4000+
LLM_MAX_TOKENS=1500
# Рассуждения DeepSeek V4: false — быстрые прямые ответы (рекомендуется), true — модель сначала думает
LLM_THINKING=false
# Таймаут одного запроса к LLM, секунд
LLM_TIMEOUT=120

CHROMA_PATH=./data/chroma
DB_PATH=./data/game.db
LORE_DIR=./lore

MAX_STAGE=5
HISTORY_WINDOW=12
TOP_K_CHUNKS=4

CHARACTER_NAME=Система «Купол»

ADMIN_PASSWORD=change_me_please

# Dome Server Integration
DOME_SERVER_URL=ws://localhost:8765
DOME_RECONNECT_DELAY=5
DOME_ENABLE_CONTROL=true
# Ключ доступа к серверу купола (выдаётся server/authorization/generate_keys.py;
# ключ администратора — data/Hash-keys/admin.txt). Настоящий ключ — только в .env
DOME_ACCESS_KEY=
